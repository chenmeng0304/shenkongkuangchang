{
	// 仅「模板部署」时用来生成初始的「服务设置」，代码发布后请以控制台为准。
	// 关键点：
	//   1. containerPort 必须与 Dockerfile 的 EXPOSE / PORT 一致（都是 80）
	//   2. minNum 必须 >= 1：世界 Boss 靠服务内定时器每天轮换，缩容到 0 就会停摆
	//   3. maxNum 先固定 1：多实例会让定时任务重复执行（目前靠数据库行锁兜底，但没必要冒险）
	"containerPort": 80,
	"minNum": 1,
	"maxNum": 1,
	"cpu": 1,
	"mem": 2,
	"policyType": "cpu",
	"policyThreshold": 60,
	"policyDetails": [
		{ "PolicyType": "cpu", "PolicyThreshold": 60 },
		{ "PolicyType": "mem", "PolicyThreshold": 70 }
	],
	"envParams": {
		"PORT": "80",
		"TZ": "Asia/Shanghai",
		"BOSS_PERIOD": "86400",
		"PVP_COOLDOWN": "10"
	},
	"customLogs": "stdout",
	"dataBaseName": "deepmine",
	"executeSQLs": [
		"CREATE DATABASE IF NOT EXISTS deepmine DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
	]
}
